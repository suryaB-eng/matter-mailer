# Copy to .env. Never paste secrets into chat.
# Dedicated personal Gmail only; confirm 2-Step Verification and App passwords first.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# API key from an unbilled Google AI Studio project; no paid fallback.
GEMINI_API_KEY=
# Leave empty until current free-tier availability is verified.
GEMINI_MODEL=
# Set once immediately before the first live probe; never reset during redeploy.
MAIL_START_AT=
DATA_DIR=/data
# Explicit separate user-controlled mailbox; never inferred from a profile.
TEST_RECIPIENT=
