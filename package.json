{
  "name": "matter-mailer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "node --env-file-if-exists=.env dist/cli.js doctor",
    "probe": "node --env-file-if-exists=.env dist/cli.js probe",
    "fetch": "node dist/cli.js fetch"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "archiver": "7.0.1",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "playwright": "1.64.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "7.0.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.11",
    "@types/yauzl": "3.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
